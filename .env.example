# Variables à renseigner dans l'interface Coolify (NE JAMAIS commiter de vrais secrets !)
PORT=3000
TRUST_PROXY=true
DATA_DIR=/data

# Titre de l'événement (modifiable en direct dans le panneau Admin)
EVENT_TITLE=Pixel War ISMIN

# Secret aléatoire obligatoire (générer avec : openssl rand -hex 32)
SESSION_SECRET=A_DEFINIR_DANS_COOLIFY

# Authentification Authentik OBLIGATOIRE (verrouille tout HTTP + WebSocket si non connecté)
REQUIRE_AUTHENTIK=true
TRUST_AUTHENTIK_HEADERS=true
AUTHENTIK_LOGIN_URL=https://auth.minitel.dev/if/user/

# Contrôle strict des administrateurs :
# - Groupes Authentik automatiquement admins (par défaut UNIQUEMENT admins-infra)
AUTHENTIK_ADMIN_GROUPS=admins-infra
# - Identifiants Authentik fixes admins (séparés par des virgules, ex: arthur,camille)
#   D'autres admins peuvent ensuite être ajoutés/retirés en direct depuis l'onglet 👑 Admins !
ADMIN_USERS=
# - Laisser VIDE pour désactiver totalement la connexion admin par mot de passe
ADMIN_PASSWORD=

# Dimensions initiales (16 à 1000, modifiables en direct sans perte)
CANVAS_WIDTH=128
CANVAS_HEIGHT=128

# Cooldown initial en millisecondes (5000 = 5s, modifiable en direct)
COOLDOWN_MS=5000
MAX_CHARGES=1
COOLDOWN_MODE=authentik

# Auto-snapshot PNG + binaire toutes les X minutes dans /data/snapshots (0 = désactivé)
AUTO_SNAPSHOT_MINUTES=15
MAX_AUTO_SNAPSHOTS=48

# Système de Lootboxes aléatoires (1 joueur connecté tiré au sort toutes les X minutes)
LOOTBOX_ENABLED=true
LOOTBOX_INTERVAL_MINUTES=60
