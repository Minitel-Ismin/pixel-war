# Variables à renseigner dans l'interface Coolify (NE JAMAIS commiter de vrais secrets !)
PORT=3000
TRUST_PROXY=true
DATA_DIR=/data

# Titre de l'événement (modifiable en direct dans le panneau Admin)
EVENT_TITLE=Pixel War ISMIN

# Secrets obligatoires (générer avec : openssl rand -hex 24)
ADMIN_PASSWORD=A_DEFINIR_DANS_COOLIFY
SESSION_SECRET=A_DEFINIR_DANS_COOLIFY

# Dimensions initiales (16 à 1000, modifiables en direct sans perte)
CANVAS_WIDTH=128
CANVAS_HEIGHT=128

# Cooldown initial en millisecondes (5000 = 5s, modifiable en direct)
COOLDOWN_MS=5000
MAX_CHARGES=1

# Mode d'identification (jamais par IP sur MINITEL car tout le trafic passe par le VPS)
# - client    : session navigateur signée (par défaut pour une appli publique *.asso.minitel.dev)
# - authentik : par compte Authentik (si forward_auth est activé sur Sakura)
COOLDOWN_MODE=client

# Intégration Authentik forward-auth (mettre à true UNIQUEMENT si la route Caddy a auth = "forward_auth")
TRUST_AUTHENTIK_HEADERS=false
AUTHENTIK_ADMIN_GROUPS=admins-infra,MINITEL

# Auto-snapshot PNG + binaire toutes les X minutes dans /data/snapshots (0 = désactivé)
AUTO_SNAPSHOT_MINUTES=15
